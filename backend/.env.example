DATABASE_URL="postgresql://user:password@host:5432/database"
DIRECT_URL="postgresql://user:password@host:5432/database"
PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"
AUTH_COOKIE_NAME="obikards_session"
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=12
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=5
TRUST_PROXY=false

# Utilisées uniquement par npm run auth:create-admin.
AUTH_ADMIN_EMAIL="admin@example.com"
AUTH_ADMIN_PASSWORD="replace-with-a-strong-password"
AUTH_ADMIN_DISPLAY_NAME="Administrateur"

SPORTSCARDSPRO_API_BASE_URL=""
SPORTSCARDSPRO_API_TOKEN=""