DATABASE_URL="postgresql://user:password@host:5432/database"
DIRECT_URL="postgresql://user:password@host:5432/database"
TEST_DATABASE_URL="postgresql://user:password@host:5432/obikards_test"
TEST_DIRECT_URL="postgresql://user:password@host:5432/obikards_test"
PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"
AUTH_COOKIE_NAME="obikards_session"
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=12
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=5
TRUST_PROXY=false
INVENTORY_PHOTO_DIR="./data/inventory-photos"
INVENTORY_PHOTO_MAX_BYTES=5242880
BACKUP_DIR="./data/backups"
BACKUP_MIN_FREE_BYTES=536870912
BACKUP_MAX_ARCHIVE_BYTES=2147483648
BACKUP_MAX_EXTRACTED_BYTES=5368709120
BACKUP_MAX_ENTRIES=20000
BACKUP_MAX_COMPRESSION_RATIO=100
PG_DUMP_PATH="pg_dump"
PG_RESTORE_PATH="pg_restore"
PSQL_PATH="psql"

# Utilisées uniquement par npm run auth:create-admin.
AUTH_ADMIN_EMAIL="admin@example.com"
AUTH_ADMIN_PASSWORD="replace-with-a-strong-password"
AUTH_ADMIN_DISPLAY_NAME="Administrateur"

SPORTSCARDSPRO_API_BASE_URL=""
SPORTSCARDSPRO_API_TOKEN=""