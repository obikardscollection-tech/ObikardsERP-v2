model MarketProviderCard {
  id String @id @default(cuid())

  marketCardId     String
  marketProviderId String

  providerCardId String
  providerUrl    String?

  providerChecksum String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  active Boolean @default(true)

  marketCard     MarketCard     @relation(fields: [marketCardId], references: [id])
  marketProvider MarketProvider @relation(fields: [marketProviderId], references: [id])

  snapshots MarketSnapshot[]
  history   MarketHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketProviderId, providerCardId])
  @@index([marketCardId])
  @@index([marketProviderId])
  @@index([providerCardId])
  @@index([active])
}
