enum MarketLinkStatus {
  NOT_FOUND
  LINKED
  MULTIPLE_MATCHES
}

model Inventory {
  id  String @id @default(cuid())
  sku String @unique

  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  receptionItemId String?
  receptionItem   ReceptionItem? @relation(fields: [receptionItemId], references: [id], onDelete: SetNull)

  category String
  title    String

  purchasePrice Float?
  salePrice     Float?

  quantity Int @default(1)

  status String @default("IN_STOCK")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location String?
  notes    String?

  autograph      Boolean   @default(false)
  backPhoto      String?
  brand          String?
  cardNumber     String?
  caseHit        Boolean   @default(false)
  certification  String?
  confidence     String?
  customsCost    Float?
  extraPhotos    Json?
  frontPhoto     String?
  goal           String?
  grade          String?
  gradeCompany   String?
  graded         Boolean   @default(false)
  memorabilia    Boolean   @default(false)
  minimumPrice   Float?
  numbered       Boolean   @default(false)
  origin         String?
  parallel       String?
  patch          Boolean   @default(false)
  player         String?
  priority       String?
  product        String?
  purchaseDate   DateTime?
  purchaseSource String?
  rookie         Boolean   @default(false)
  serialNumber   String?
  series         String?
  shippingCost   Float?
  sp             Boolean   @default(false)
  sport          String?
  ssp            Boolean   @default(false)
  supplier       String?
  taxes          Float?
  team           String?
  variant        String?
  year           Int?

  sportsCardsProId String?
  marketLinkStatus MarketLinkStatus? @default(NOT_FOUND)
  marketMatches    Json?

  marketLastRefreshAt DateTime?

  marketValueUsd Float?
  marketValueEur Float?
  marketSource   String?
  marketCurrency String?

  profit Float?
  margin Float?
  roi    Float?

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([purchaseItemId])
  @@index([receptionItemId])
}
