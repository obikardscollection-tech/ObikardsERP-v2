model MarketImportError {
  id String @id @default(cuid())

  marketImportJobId String

  lineNumber Int?

  providerCardId String?

  field String?

  errorCode String?

  message String

  rawData Json?

  resolved Boolean @default(false)

  marketImportJob MarketImportJob @relation(fields: [marketImportJobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
