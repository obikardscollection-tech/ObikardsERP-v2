model PurchaseItem {
  id String @id @default(cuid())

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  name String

  cardReference String?

  quantity Int @default(1)

  unitPrice  Float
  totalPrice Float

  condition String?

  sku String?

  notes String?

  inventoryCreated Boolean @default(false)

  inventory      Inventory[]
  receptionItems ReceptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([name])
  @@index([cardReference])
  @@index([inventoryCreated])
}
