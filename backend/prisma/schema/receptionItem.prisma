model ReceptionItem {
  id String @id @default(cuid())

  receptionId String
  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)

  purchaseItemId String
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  quantityReceived Int
  quantityRemaining Int

  inventoryCreated Boolean @default(false)

  inventory Inventory[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receptionId])
  @@index([purchaseItemId])
  @@index([inventoryCreated])
}
