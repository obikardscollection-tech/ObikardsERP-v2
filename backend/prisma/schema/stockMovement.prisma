model StockMovement {
  id String @id @default(cuid())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  type   StockMovementType
  source StockMovementSource @default(MANUAL)

  quantity         Int
  previousQuantity Int
  newQuantity      Int

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  receptionId String?
  reception   Reception? @relation(fields: [receptionId], references: [id], onDelete: SetNull)

  reason String?

  userId String?

  notes String?

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([type])
  @@index([source])
  @@index([purchaseId])
  @@index([saleId])
  @@index([receptionId])
  @@index([createdAt])
  @@index([inventoryId, createdAt])
}
