model Supplier {
  id String @id @default(cuid())

  supplierNumber String @unique

  name    String
  company String?

  email   String? @unique
  phone   String?
  website String?

  address    String?
  postalCode String?
  city       String?
  country    String?

  contactName String?

  currency String @default("EUR")

  isActive Boolean @default(true)

  notes String?

  purchases Purchase[]
  expenses  Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
  @@index([country])
  @@index([currency])
  @@index([isActive])
}
