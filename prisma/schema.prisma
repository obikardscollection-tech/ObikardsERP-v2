generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  CORRECTION
  IMPORT
  EXPORT
}

enum StockMovementSource {
  MANUAL
  EBAY
  WOOCOMMERCE
  WHATNOT
  API
  SYSTEM
  IMPORT
}

model Inventory {
  id String @id @default(cuid())

  // Identification
  sku      String @unique
  category String
  title    String

  // Informations générales
  sport      String?
  year       Int?
  brand      String?
  series     String?
  product    String?
  player     String?
  team       String?
  cardNumber String?

  // Caractéristiques
  rookie       Boolean @default(false)
  autograph    Boolean @default(false)
  patch        Boolean @default(false)
  memorabilia  Boolean @default(false)
  numbered     Boolean @default(false)
  serialNumber String?
  caseHit      Boolean @default(false)
  sp           Boolean @default(false)
  ssp          Boolean @default(false)
  variant      String?
  parallel     String?

  // Gradation
  graded        Boolean @default(false)
  gradeCompany  String?
  grade         String?
  certification String?

  // Achat
  purchasePrice  Float?
  shippingCost   Float?
  customsCost    Float?
  taxes          Float?
  purchaseDate   DateTime?
  supplier       String?
  purchaseSource String?
  origin         String?

  // Vente
  salePrice    Float?
  minimumPrice Float?
  goal         String?
  confidence   String?

  // Stock
  quantity Int     @default(1)
  status   String  @default("IN_STOCK")
  location String?
  priority String?
  notes    String?

  // Photos
  frontPhoto  String?
  backPhoto   String?
  extraPhotos Json?

  // Relations
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockMovement {
  id String @id @default(cuid())

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  type   StockMovementType
  source StockMovementSource @default(MANUAL)

  quantity Int

  previousQuantity Int
  newQuantity      Int

  reason String?

  userId String?

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([type])
  @@index([source])
  @@index([createdAt])
}
