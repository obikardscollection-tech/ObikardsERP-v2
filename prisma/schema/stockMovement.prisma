model StockMovement {
  id               String              @id @default(cuid())
  inventoryId      String
  type             StockMovementType
  source           StockMovementSource @default(MANUAL)
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  userId           String?
  createdAt        DateTime            @default(now())
  inventory        Inventory           @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([type])
  @@index([source])
  @@index([createdAt])
}
