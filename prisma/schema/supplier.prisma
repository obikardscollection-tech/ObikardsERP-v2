model Supplier {
  id String @id @default(cuid())

  name String
  company String?

  email String?
  phone String?

  website String?

  address String?
  postalCode String?
  city String?
  country String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([email])
}